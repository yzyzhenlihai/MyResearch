{
  "runtime_prefix": "PYTHONPATH=.:./src:./src/DeepCTR-Torch MPLCONFIGDIR=/tmp/mpl conda run -n easyrl4rec",
  "config": {
    "env": "KuaiEnv-v0",
    "user_model_name": "DeepFM",
    "read_message": "pointneg",
    "seed": 2023,
    "cpu": true,
    "cuda": 0,
    "is_userinfo": false,
    "random_init": true,
    "trajectory_pkl_path": "data/KuaiRec/data_processed/DM_KuaiEnv-v0_small_data.pkl",
    "small_csv_path": "data/KuaiRec/data_raw/small_matrix_processed.csv",
    "leave_threshold": 0,
    "num_leave_compute": 1,
    "max_turn": 30,
    "anchor_states_per_user": 4,
    "use_nx0_mask": true,
    "shortlist_top_rhat": 64,
    "shortlist_top_uncertainty": 64,
    "shortlist_top_true_high": 64,
    "shortlist_top_true_low": 64,
    "shortlist_top_leave": 32,
    "shortlist_random": 32,
    "distance_metric": "cosine",
    "near_q": 0.2,
    "far_q": 0.8,
    "reward_high_q": 0.8,
    "reward_low_q": 0.2,
    "lambda_grid": [
      0.0,
      0.05,
      146.0,
      486.0,
      1460.0
    ],
    "topk_list": [
      1,
      5,
      10,
      20
    ],
    "highvar_alpha_list": [
      0.1,
      0.2
    ],
    "highvar_plot_alpha": 0.1,
    "lambda_plot_topk": 20,
    "plot_sample_n": 120000,
    "action_alignment_atol": 1e-05,
    "action_alignment_max_samples": 4096,
    "output_dir": "results/ood_granularity_experiment",
    "max_users": 0,
    "smoke_test": false
  },
  "extra": {
    "sample_metrics_path": "results/ood_granularity_experiment/sample_metrics.csv.gz",
    "summary_metrics_path": "results/ood_granularity_experiment/summary_metrics.json",
    "label_counts_path": "results/ood_granularity_experiment/label_counts.json",
    "report_path": "results/ood_granularity_experiment/ood_granularity_report.md",
    "figure_paths": {
      "distance_vs_true_reward": "results/ood_granularity_experiment/figures/fig_distance_vs_true_reward.png",
      "uncertainty_violin": "results/ood_granularity_experiment/figures/fig_uncertainty_violin_quadrants.png",
      "highvar_composition": "results/ood_granularity_experiment/figures/fig_highvar_composition.png",
      "lambda_response": "results/ood_granularity_experiment/figures/fig_lambda_response_curves.png"
    }
  }
}